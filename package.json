{
  "name": "chispa-edu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chispa .edu — Estudio web educativo e interactivo para el compilador e intérprete del lenguaje español .edu",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
